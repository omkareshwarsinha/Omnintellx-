#!/bin/sh
# Gradle start up script for POSIX systems
APP_BASE_NAME=`basename "$0"`
APP_HOME="`pwd -P`"
DEFAULT_JVM_OPTS='"-Xmx64m" "-Xms64m"'

# Find java
if [ -n "$JAVA_HOME" ] ; then
    if [ -x "$JAVA_HOME/jre/sh/java" ] ; then
        JAVACMD="$JAVA_HOME/jre/sh/java"
    else
        JAVACMD="$JAVA_HOME/bin/java"
    fi
else
    JAVACMD="java"
fi

echo "Omnintellx Gradle Build Wrapper (API 28+)"
if which $JAVACMD >/dev/null 2>&1; then
    exec "$JAVACMD" $DEFAULT_JVM_OPTS -jar "$APP_HOME/gradle/wrapper/gradle-wrapper.jar" "$@"
else
    echo "Notice: Java environment not found in path. Please open this directory in Android Studio or install openjdk-17."
    exit 0
fi
