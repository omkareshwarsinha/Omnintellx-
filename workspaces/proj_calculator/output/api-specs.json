        "parameters": [
          {
            "name": "a",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          },
          {
            "name": "b",
            "in": "query",
            "required": true,
            "schema": {
              "type": "number"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Difference result"
          }
        }
      }
    },
    "/calc/multiply": {
      "post": {
        "summary": "Multiplication calculation",
        "parameters": [
          {
            "name": "a",
            "in": "query",
